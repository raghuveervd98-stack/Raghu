{
	"name": "DataServingLayer",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "lsadfraghu",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirline"
				},
				{
					"linkedService": {
						"referenceName": "lsadfraghu",
						"type": "LinkedServiceReference"
					},
					"name": "DimFlight"
				},
				{
					"linkedService": {
						"referenceName": "lsadfraghu",
						"type": "LinkedServiceReference"
					},
					"name": "factBooking"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "lsadfraghu",
						"type": "LinkedServiceReference"
					},
					"name": "sinkGold1"
				},
				{
					"linkedService": {
						"referenceName": "lsadfraghu",
						"type": "LinkedServiceReference"
					},
					"name": "sinkGold2"
				}
			],
			"transformations": [
				{
					"name": "AirLineJoin"
				},
				{
					"name": "selectCols"
				},
				{
					"name": "aggregateAirline"
				},
				{
					"name": "Ranking"
				},
				{
					"name": "filterTop5"
				},
				{
					"name": "DimFlightJoin"
				},
				{
					"name": "selectColumn"
				},
				{
					"name": "aggregateDimflight"
				},
				{
					"name": "Ranking1"
				},
				{
					"name": "filterTop5Flights"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirline') ~> DimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_timestamp as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimFlight') ~> DimFlight",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as integer,",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactBooking') ~> factBooking",
				"factBooking, DimAirline join(factBooking@airline_id == DimAirline@airline_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> AirLineJoin",
				"AirLineJoin select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id = {factBooking@flight_id},",
				"          airline_id = factBooking@airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          airline_name,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCols",
				"selectCols aggregate(groupBy(airline_name),",
				"     Total_sales = sum(ticket_cost)) ~> aggregateAirline",
				"aggregateAirline window(desc(Total_sales, true),",
				"     Top = denseRank()) ~> Ranking",
				"Ranking filter(Top < 6) ~> filterTop5",
				"DimFlight, factBooking join(DimFlight@flight_id == factBooking@flight_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> DimFlightJoin",
				"DimFlightJoin select(mapColumn(",
				"          flight_id = DimFlight@flight_id,",
				"          flight_number,",
				"          departure_timestamp,",
				"          arrival_time,",
				"          booking_id,",
				"          passenger_id,",
				"          airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumn",
				"selectColumn aggregate(groupBy(flight_number),",
				"     Total_duration = sum(flight_duration_mins)) ~> aggregateDimflight",
				"aggregateDimflight window(desc(Total_duration, true),",
				"     Top = denseRank()) ~> Ranking1",
				"Ranking1 filter(Top<6) ~> filterTop5Flights",
				"filterTop5 alterRow(insertIf(1>0)) ~> alterRow1",
				"filterTop5Flights alterRow(insertIf(1>0)) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'businessView',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     keys:['airline_name'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkGold1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'BusinessView2',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkGold2"
			]
		}
	}
}